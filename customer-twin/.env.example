# Copy to .env and fill in your own values. .env is gitignored.

# Optional: MongoDB Atlas persistence for signal status and bandit learning.
# Leave unset to run with in-memory demo state.
MONGO_DB_LINK=
MONGO_DB_NAME=InibsaProject

# Required to enable POST /api/signals/{id}/voice_briefing.
# When unset, the endpoint returns HTTP 503 and the frontend hides the audio
# control gracefully — the rest of the app keeps working.
ELEVENLABS_API_KEY=

# Optional: override the default voice ID.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional: cap on number of clients processed at API startup. Lower for
# faster dev cycles, higher for production runs.
# CT_MAX_CLIENTS=1500

# Optional: set to 0 if you want the container to skip automatic ETL from
# data/raw/Datasets.xlsx when processed parquet files are missing.
# CT_RUN_ETL_ON_START=auto
